[Unit]
Description=HH Vacancy Scraper (headless-browser sidecar)
After=network.target

[Service]
Type=simple
User=rover
Group=rover
WorkingDirectory=/opt/hh-gui/scraper
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
