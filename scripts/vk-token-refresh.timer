[Unit]
Description=Обновлять пользовательский токен VK дважды в сутки (токен живёт 24 ч)

[Timer]
# Дважды в сутки: запас в 12 часов на случай, если один запуск упадёт (сеть, VK).
# «03:20,15:20» systemd читает как 03:15:20 и 03:20:20 (минуты 20,15) — второго
# запуска днём не было, и токен обновлялся за минуты до истечения (23.09.2026).
OnCalendar=*-*-* 03,15:20:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
