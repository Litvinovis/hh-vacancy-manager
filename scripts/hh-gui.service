[Unit]
Description=HH Vacancy Manager
After=network.target

[Service]
Type=simple
User=rover
Group=rover
WorkingDirectory=/opt/hh-gui
EnvironmentFile=/opt/hh-gui/.env
ExecStart=/usr/bin/java --enable-native-access=ALL-UNNAMED -Xms128m -Xmx512m -Xss512k -XX:MaxMetaspaceSize=192m -XX:+UseG1GC -jar /opt/hh-gui/hh-gui.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
